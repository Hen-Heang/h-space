{
  "name": "h-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "dev:web": "pnpm --dir apps/web dev",
    "lint": "pnpm lint:web",
    "lint:web": "pnpm --dir apps/web lint",
    "format:web": "pnpm --dir apps/web format",
    "format:web:check": "pnpm --dir apps/web format:check",
    "test": "pnpm test:web",
    "test:web": "pnpm --dir apps/web test",
    "build": "pnpm build:web",
    "build:web": "pnpm --dir apps/web build"
  }
}
