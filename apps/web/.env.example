# Public origin this deployment is served from. Used as metadataBase so
# relative Open Graph / Twitter image URLs resolve to absolute ones. Omit it
# and the production domain is assumed; set it for preview or local builds.
NEXT_PUBLIC_SITE_URL=https://hengo.henheang.site

# Browser-visible Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# h-space-api (sign-in, sessions, the Supabase token bridge). Falls back to
# http://localhost:8080 when unset, so every deployed environment must set it.
# The API must list this app's origin in its CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_AUTH_API_URL=https://your-h-space-api.example.com

# Server-only OpenAI configuration. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1

# Explicit local UI mode. Mock output is visibly labeled and does not call OpenAI.
KOREAN_COACH_MOCK_MODE=false

# Hengo MCP connector (docs/chatgpt-mcp-integration.md), serving Claude and,
# where supported, ChatGPT. The first three are required together — the /mcp
# endpoint returns 503 and serves nothing until they are set. There is no
# "disable auth" option by design.
# MCP_RESOURCE_URL must be the endpoint's own public https URL: it is published
# as the RFC 8707 resource identifier and every access token's audience is
# checked against it.
MCP_RESOURCE_URL=https://your-deployment.example.com/mcp
SUPABASE_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
# Comma-separated allowlist of OAuth client ids permitted to call the
# endpoint (e.g. one per registered connector — Claude, ChatGPT). Tokens
# issued to any other client are rejected. Must contain at least one id: an
# empty list is a configuration error, not "allow everyone".
MCP_ALLOWED_CLIENT_IDS=the_oauth_client_id_registered_for_claude,the_oauth_client_id_registered_for_chatgpt
# Gates the write tools (create/update/complete/capture). Defaults to false
# — the write tools are absent from tools/list entirely until this is set to
# the literal string "true". Verify the read tools end to end first.
MCP_WRITE_ENABLED=false

# Existing optional browser integrations
# Google sign-in may still use this browser-visible id. Calendar authorization
# itself now starts from a server route and prefers GOOGLE_CLIENT_ID below.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_oauth_client_id
NEXT_PUBLIC_VAPID_KEY=your_web_push_vapid_public_key

# Google Calendar integration (Settings > Integrations).
# Prefer the server-only client id for Calendar OAuth. If omitted, Hengo falls
# back to NEXT_PUBLIC_GOOGLE_CLIENT_ID for compatibility with older deploys.
GOOGLE_CLIENT_ID=your_google_web_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Register this exact authorized redirect URI on the same Google OAuth client:
#   https://hengo.henheang.site/integrations/google-calendar/callback
# Add preview/local origins too only when you intentionally test them.
#
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# stored Google access/refresh tokens at rest (lib/server/google-calendar-store.ts).
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=your_base64_encoded_32_byte_key
# Project Settings > API > service_role in the Supabase dashboard. Used only
# by lib/server/google-calendar-store.ts, to store/read Google Calendar
# tokens in a way even the owning user's own JWT can't select — RLS alone
# can't express that. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional one-way Notion copy for Quick Capture.
# Hengo stays the source of truth. When enabled, More options in Quick Capture
# offers "Also copy to Notion" and creates a child page under the configured
# parent. Share that parent page with the Notion integration and grant Insert
# Content capability before enabling this flag.
NEXT_PUBLIC_NOTION_CAPTURE_ENABLED=false
NOTION_API_KEY=your_notion_internal_integration_token
NOTION_CAPTURE_PARENT_PAGE_ID=your_notion_parent_page_id

# Existing global model overrides
AI_MODEL=gpt-5-mini
TTS_MODEL=tts-1

# Integrations settings section (/settings/integrations) and its Google
# Calendar card. Off until the Plan section has a navigation entry — the card
# exists to show your calendar beside Hengo tasks, and Tasks/Calendar are not
# reachable from the nav yet. A learner who is already connected still sees
# the card regardless, so "Disconnect" is never hidden behind this flag.
NEXT_PUBLIC_FEATURE_INTEGRATIONS=false
