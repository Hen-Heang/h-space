# Supabase Auth (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Neon Postgres (server-only — never prefix with NEXT_PUBLIC_)
DATABASE_URL=

# Browser Web Push (VAPID). The public key is intentionally exposed to the
# browser; the private key must remain server-only. Generate a dedicated Luyra
# key pair with `npx web-push generate-vapid-keys` and never commit the private
# key. VAPID_SUBJECT should be a contact URI such as mailto:you@example.com.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional. Server-only. ExchangeRate-API key for the USD->KRW rate
# (https://www.exchangerate-api.com). Without it, the app uses the same
# provider's free keyless endpoint, updated daily — still a real live rate.
# A key adds higher limits and more frequent updates.
EXCHANGE_RATE_API_KEY=

# Optional. Telegram bot integration for on-demand Finance report delivery.
# Get a token from @BotFather (https://t.me/BotFather). Without these three
# set, the app just shows "Telegram isn't configured" — nothing breaks.
#
# TELEGRAM_BOT_TOKEN: server-only, secret. Used to send messages.
# TELEGRAM_WEBHOOK_SECRET: server-only, secret. A value you choose yourself
#   and pass as `secret_token` when registering the webhook with Telegram's
#   setWebhook API — this app's webhook route rejects any request whose
#   `X-Telegram-Bot-Api-Secret-Token` header doesn't match it. You must
#   register the webhook yourself (e.g. via a one-off curl to
#   https://api.telegram.org/bot<TOKEN>/setWebhook) once this app is
#   deployed at a public HTTPS URL — nothing in this codebase calls
#   setWebhook automatically.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME: public, safe to expose. Your bot's
#   @handle (no leading @), used only to build the t.me deep link shown in
#   Finance Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Optional. Server-only. Enables the Finance AI Money Coach. lib/ai/client.ts
# is the shared AI abstraction, so future Luyra features can use the same
# client. Without it, Settings just shows "AI Money Coach isn't configured"
# and nothing breaks.
# Get a key at https://console.anthropic.com.
#
# ANTHROPIC_API_KEY: server-only, secret.
# ANTHROPIC_MODEL: optional override of the default model (claude-opus-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional. Server-only. Enables on-demand email delivery of the Weekly
# summary and Monthly report (lib/email/client.ts). Without it, Settings just
# shows "Email isn't configured" — nothing breaks. Get a key at
# https://resend.com. The weekly/monthly cron jobs deliver on every channel
# the user enabled, so email now goes out on the same schedule as Telegram;
# the "Send email" button in Settings remains for sending one on demand.
#
# RESEND_API_KEY: server-only, secret.
# RESEND_FROM_EMAIL: optional override of the sender address, e.g.
#   "Luyra <reports@yourdomain.com>" — requires a domain verified with
#   Resend. Without it, mail sends from Resend's shared sandbox address
#   (onboarding@resend.dev), which works but is more likely to be filtered.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. Server-only, secret. Authorizes the scheduled jobs in vercel.json
# (Telegram and push budget alerts, spending spikes, the daily reminders, and
# the weekly/monthly reports). Every /api/cron/* route requires
# `Authorization: Bearer <CRON_SECRET>` and returns 503 when this is unset, so
# leaving it blank disables scheduling rather than exposing the routes.
#
# Generate any long random string, e.g. `openssl rand -hex 32`, and set the
# same value in the Vercel project — Vercel Cron then sends the header
# automatically. Never expose it to the browser.
CRON_SECRET=
